# ArchAI Demo 配置文件
# 使用方法：复制本文件为 .env，填入你自己的 API Key
# 注意：.env 已被 .gitignore 排除，不会提交到代码库

# ── Dify 知识库 API（多源检索架构）──────────────
# 在 Dify 控制台 → 知识库 → 设置 → API 访问 获取
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_API_KEY=dataset-你的知识库APIKey

# 知识库1：案例库（25个建筑案例）
DIFY_DATASET_ID=你的案例库DatasetID
# 知识库2：理论+方法库（6理论+15方法）
DIFY_THEORY_DATASET=你的理论方法库DatasetID

# ── DeepSeek 设计大脑 API ────────────────────────
# 在 https://platform.deepseek.com 创建
DEEPSEEK_API_KEY=sk-你的DeepSeekKey

# ── Qwen-VL 图片理解 ───────────────────────────
# 在阿里云百炼控制台创建。图片上传前页面会向用户确认，图片将发送到该外部服务。
DASHSCOPE_API_KEY=sk-你的百炼APIKey
